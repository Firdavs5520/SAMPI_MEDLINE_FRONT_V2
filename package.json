{
  "name": "sampi-medline-frontend",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1",
    "desktop:dev": "electron .",
    "desktop:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-installer.ps1",
    "desktop:exe": "npm run desktop:installer",
    "smoke:electron-routes": "electron scripts/smoke-electron-routes.cjs",
    "smoke:multi-role": "electron scripts/smoke-multi-role-routes.cjs"
  },
  "build": {
    "appId": "uz.sampimedline.desktop",
    "productName": "Sampi Medline",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "icon": "build/icon.ico",
    "directories": {
      "output": "../outputs/windows-installer"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://sampi-medline.vercel.app/desktop-updates/"
      }
    ],
    "files": [
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "sampi-medline-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sampi Medline",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "axios": "^1.13.6",
    "electron-updater": "^6.8.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.13",
    "vite": "^8.0.1"
  }
}
